rules_version = '2';

/**
 * Firestore Security Rules — AI Job Application Tracker
 *
 * For viva:
 * Firestore Security Rules are evaluated server-side by Firebase BEFORE any
 * read or write reaches the database. They are a second layer of protection
 * in addition to our application-level ownership checks.
 *
 * Key principle: Defense in depth.
 * - Layer 1: Service functions check doc.userId === authenticatedUserId
 * - Layer 2: These rules enforce the same check at the database level
 *
 * How request.auth works:
 * Firebase automatically populates request.auth with the signed-in user's
 * JWT token claims when a client makes a Firestore request with a valid
 * Firebase Auth session. request.auth.uid is the Firebase UID.
 *
 * Why NOT_FOUND is returned instead of UNAUTHORIZED in service code:
 * Firestore rules here will return a permission-denied error for
 * unauthorized access. Our service layer intentionally catches this and
 * re-throws as AppError("NOT_FOUND") to avoid leaking document existence.
 *
 * Deployment:
 * 1. Install Firebase CLI:  npm install -g firebase-tools
 * 2. Login:                 firebase login
 * 3. Set project:           firebase use <your-project-id>
 * 4. Deploy rules:          firebase deploy --only firestore:rules
 *
 * Or paste these rules directly in the Firebase Console:
 * https://console.firebase.google.com → Firestore Database → Rules
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Applications collection
    // -------------------------------------------------------------------------
    match /applications/{docId} {
      // CREATE: User must be authenticated and the new document must have their UID
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      // READ: Only the document owner can read it
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      // UPDATE: Only the owner can update; userId field cannot be changed
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      // DELETE: Disabled — applications are never deleted through the app
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Documents collection (resume/file metadata)
    // -------------------------------------------------------------------------
    match /documents/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      // DELETE: Allowed — users can remove their own documents
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Reminders collection
    // -------------------------------------------------------------------------
    match /reminders/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Catch-all: deny everything else
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
