# Firebase Configuration (Optional)
# These environment variables override the default Firebase config in src/lib/firebase.ts.
# The defaults work out of the box — only set these if you want to use your own Firebase project.
#
# To use: Copy this file to .env and fill in your own values.
#   cp .env.example .env

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
